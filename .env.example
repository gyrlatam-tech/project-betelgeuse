# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_WORKSPACE_ADMIN_EMAIL: Super Admin e-mail in the main Google Workspace console to impersonate
GOOGLE_WORKSPACE_ADMIN_EMAIL=""

# GOOGLE_WORKSPACE_SERVICE_ACCOUNT_EMAIL: Service Account client email (e.g. workspace-admin-sa@project-id.iam.gserviceaccount.com)
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_EMAIL=""

# GOOGLE_WORKSPACE_PRIVATE_KEY: Service Account private key (PEM format, with \n escaped)
GOOGLE_WORKSPACE_PRIVATE_KEY=""

# GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON: Full Service Account JSON key as alternative string
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON=""

# STRIPE CONFIGURATION:
# STRIPE_SECRET_KEY: Secret API Key for server-side Stripe charges (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=""

# VITE_STRIPE_PUBLISHABLE_KEY: Client-side Publishable key (pk_live_... or pk_test_...)
VITE_STRIPE_PUBLISHABLE_KEY=""

# STRIPE_WEBHOOK_SECRET: Webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=""

# RESEND EMAIL NOTIFICATIONS:
# RESEND_API_KEY: Secret API Key for sending transactional emails (re_...)
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Sender email address (e.g. Skoolia Workspace <info@updates.skoolia.net>)
RESEND_FROM_EMAIL="Skoolia Workspace <info@updates.skoolia.net>"

